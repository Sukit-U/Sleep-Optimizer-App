# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
analysis_results.txt

# Signing material - never commit
/android/key.properties
*.jks
*.keystore
# Analysis / tooling output (never commit)
graphify-out/
scripts/node_modules/

# Firebase credentials - never commit. The scripts in scripts/ use Application
# Default Credentials or the emulator; a key file must never live in the repo.
**/service-account-key*.json
**/*-firebase-adminsdk-*.json
**/firebase-adminsdk*.json

# Local environment files — real values never get committed.
# .env.example stays tracked, so the negation must come after the patterns.
.env
.env.*
!.env.example

# Firebase's default google-services output path. There is deliberately no
# file here: android/app/src/<flavor>/google-services.json is the only valid
# location, and a file at this path would be applied to every flavor.
/android/app/google-services.json

# A failed download that landed at the repo root: audited (no credentials),
# deleted in this change, and kept out by its exact anchored path. A real .zip
# elsewhere in the tree is still tracked and still scanned.
/github-mcp-server.zip

# iOS: the app boots from the Dart FirebaseOptions, never from a plist. This
# path is one file shared by every iOS build, so a committed plist would pin
# dev or prod for all of them. Keep it ignored and local.
#
# Per-environment copies downloaded from the Console (the prod app's plist, for
# example) are parked next to it only long enough to read an app id, so they are
# ignored under any suffix as well.
/ios/Runner/GoogleService-Info.plist
/ios/Runner/GoogleService-Info.*.plist
