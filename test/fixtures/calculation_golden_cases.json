  "recommendationCases": [
    {
      "id": "rec-excellent",
      "description": "Excellent level → positive reinforcement only",
      "input": {
        "weakFactors": ["Caffeine", "Sleep regularity"],
        "level": "excellent",
        "recordId": "rec-123",
        "userId": "user-456"
      },
      "expectedOutput": [
        {
          "factor": "General",
          "title": "Keep up the great habits!",
          "description": "Your sleep habits are excellent — maintaining them will help you stay rested and perform at your best.",
          "action": "Continue with your current sleep routine and share your good habits with friends.",
          "priority": "low"
        }
      ]
    },
    {
      "id": "rec-good-single-factor",
      "description": "Good level → only the single lowest-scoring factor",
