    {
      "id": "sqi-tied-weak-factors",
      "description": "Tied weak factors — order is undefined (List.sort unstable)",
      "input": {
        "Sleep duration": 2,
        "Sleep regularity": 2,
        "Screen time": 3,
        "Exercise": 3,
        "Stress": 3,
        "Caffeine": 3
      },
      "expectedOutput": {
        "score": 52,
