          "Sleep duration": 8,
          "Sleep regularity": 8,
          "Screen time": 9,
          "Exercise": 9,
          "Stress": 9,
          "Caffeine": 9
        },
        "note": "weakFactors order for tied scores is not guaranteed; this records one observed ordering"
      }
    },
    {
      "id": "sqi-missing-keys",
      "description": "Missing keys default to 0",
      "input": {
        "Sleep duration": 3,
        "Screen time": 4
      },
      "expectedOutput": {
        "score": 24,
        "level": "poor",
        "weakFactors": ["Sleep regularity", "Exercise"],
