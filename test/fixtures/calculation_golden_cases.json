          "Sleep duration": 20,
          "Sleep regularity": 20,
          "Screen time": 15,
          "Exercise": 15,
          "Stress": 15,
          "Caffeine": 15
        },
        "note": "All 6 factors tied at max; weakFactors order is undefined (List.sort unstable). This records one observed ordering."
      }
    },
