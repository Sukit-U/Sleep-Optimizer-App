      "description": "Maximum valid responses (all fives) - tied weak factors order undefined",
      "input": {
        "Sleep duration": 5,
        "Sleep regularity": 5,
        "Screen time": 5,
        "Exercise": 5,
        "Stress": 5,
        "Caffeine": 5
      },
      "expectedOutput": {
