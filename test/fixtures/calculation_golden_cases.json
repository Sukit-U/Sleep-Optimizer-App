          "Exercise": 0,
          "Stress": 0,
          "Caffeine": 0
        }
      }
    },
    {
      "id": "sqi-out-of-range-high",
      "description": "Out-of-range values (6) are accepted and used in calculation",
      "input": {
        "Sleep duration": 6,
        "Sleep regularity": 5,
        "Screen time": 5,
        "Exercise": 5,
        "Stress": 5,
        "Caffeine": 5
      },
      "expectedOutput": {
        "score": 104,
        "level": "excellent",
        "weakFactors": ["Screen time", "Exercise"],
        "factorScores": {
          "Sleep duration": 24,
          "Sleep regularity": 20,
          "Screen time": 15,
          "Exercise": 15,
          "Stress": 15,
          "Caffeine": 15
        },
        "note": "Values > 5 are not clamped; score can exceed 100. Weak factors tied at 15; order undefined."
      }
    },
    {
      "id": "sqi-out-of-range-negative",
      "description": "Negative values are accepted and used in calculation",
      "input": {
        "Sleep duration": -1,
        "Sleep regularity": 5,
        "Screen time": 5,
        "Exercise": 5,
        "Stress": 5,
        "Caffeine": 5
      },
      "expectedOutput": {
        "score": 76,
        "level": "good",
        "weakFactors": ["Sleep duration", "Screen time"],
        "factorScores": {
          "Sleep duration": -4,
          "Sleep regularity": 20,
          "Screen time": 15,
          "Exercise": 15,
          "Stress": 15,
          "Caffeine": 15
        },
        "note": "Negative values are not clamped; factor score can be negative."
      }
    }
