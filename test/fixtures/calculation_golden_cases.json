  "sqiCases": [
    {
      "id": "sqi-typical-valid",
      "description": "Typical valid responses across all factors",
      "input": {
        "Sleep duration": 3,
        "Sleep regularity": 2,
        "Screen time": 4,
        "Exercise": 3,
        "Stress": 2,
        "Caffeine": 1
      },
      "expectedOutput": {
        "score": 50,
        "level": "fair",
        "weakFactors": ["Caffeine", "Stress"],
        "factorScores": {
          "Sleep duration": 12,
          "Sleep regularity": 8,
          "Screen time": 12,
          "Exercise": 9,
          "Stress": 6,
          "Caffeine": 3
        }
      }
    },
    {
      "id": "sqi-minimum-responses",
      "description": "Minimum valid responses (all zeros)",
      "input": {
        "Sleep duration": 0,
        "Sleep regularity": 0,
        "Screen time": 0,
        "Exercise": 0,
        "Stress": 0,
        "Caffeine": 0
      },
      "expectedOutput": {
        "score": 0,
